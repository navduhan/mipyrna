[workflow]
input_file = samples.txt
input_path = fastq
genome = genome.fa
species = ath
species_type = plants
outdir = mipyrna_results
cpu = 160
jobs = 6
trimmer = trimmomatic
skip_qc = true
read_cutoff = 20
min_mature_reads = 10
require_star = true
max_inconsistent = 0.25
min_5p_consistency = 0.5
known_scan = false
known_min_reads = 10
known_5p_tolerance = 2
known_unique = false
rfam_filter = false

[slurm]
partition = compute
account =
time = 3-00:00:00
